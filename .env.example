# Supabase project connection (safe to expose in the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# OVH Backend API Authentication
# Token used by useSpotReport.ts to authenticate with the backend report API
VITE_CLIENT_TOKEN=your-client-token

# Access Control for Pilot Stage
# Leave empty to allow all authenticated users (development default)
# Set to comma-separated emails to restrict access in production
VITE_ALLOWED_EMAILS=
